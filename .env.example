# Copy to .env and fill in. .env is gitignored; never commit it.
#
# The bot reads this file from its working directory at start-up (variables
# already set in the environment win). deploy/deploy.sh copies only the
# exchange and Telegram lines to the host, as /opt/safetrade/etc/safetrade.env;
# the DigitalOcean and host lines stay on your machine.

# --- SafeTrade exchange (required for anything but `report`) ---------------
# Create the key in the SafeTrade UI and allowlist the trading host's IPv4
# address on it, or every private call fails with authz.apikey_untrusted_ip.
SAFETRADE_API_KEY=
SAFETRADE_API_SECRET=

# --- Telegram (optional) ---------------------------------------------------
# Bot token from @BotFather, in the form 123456789:AA... Without it the bot
# runs silently. TELEGRAM and TELGRAM are accepted as older aliases.
TELEGRAM_BOT_TOKEN=
# Pins the bot to one chat. Leave empty and the first chat to send /start
# claims it; every other chat is ignored from then on.
TELEGRAM_CHAT_ID=

# --- Deployment (deploy/*.sh, local only) ----------------------------------
# IPv4 address of the trading host; the scripts ssh in as root.
SAFETRADE_HOST=
# DigitalOcean droplet id and API token, used by deploy/bootstrap.sh to check
# the droplet and power it on. Not needed by deploy.sh or pull-db.sh.
SAFETRADE_DROPLET_ID=
DIGITAL_OCEAN_API_KEY=
